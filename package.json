{
  "name": "givrelune",
  "version": "0.1.0",
  "description": "Un marché de Noël 3D cosy et open source : promenez-vous dans le village féerique de Givrelune, discutez avec les artisans et découvrez leurs créations.",
  "type": "module",
  "license": "MIT",
  "private": false,
  "keywords": ["christmas-market", "threejs", "3d", "e-commerce", "cosy-game", "open-source", "marche-de-noel"],
  "engines": { "node": ">=20.19" },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "scan": "tsx scripts/scan.ts",
    "shoot": "node scripts/shoot.mjs",
    "e2e": "playwright test"
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^20.19.43",
    "@types/three": "^0.187.0",
    "node-html-parser": "^9.0.7",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^8.3.6",
    "vitest": "^4.1.12"
  }
}
