{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://givrelune.dev/schema/market.schema.json",
  "title": "Marché de Givrelune",
  "type": "object",
  "required": [
    "meta"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "meta": {
      "type": "object",
      "required": [
        "title",
        "town"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "town": {
          "type": "string"
        },
        "tagline": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "locale": {
          "enum": [
            "fr",
            "en"
          ]
        },
        "organizer": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "url": {
              "type": "string"
            }
          }
        }
      }
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timeOfDay": {
          "enum": [
            "dusk",
            "night"
          ]
        },
        "accent": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "description": "Couleur hexadécimale, ex. #b8413a"
        },
        "lightColor": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "description": "Couleur hexadécimale, ex. #b8413a"
        },
        "aurora": {
          "type": "boolean"
        },
        "snow": {
          "type": "number",
          "minimum": 0,
          "maximum": 3
        }
      }
    },
    "story": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "intro": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "finale": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "stars": {
          "type": "number",
          "minimum": 1,
          "maximum": 7
        }
      }
    },
    "music": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "shuffle": {
          "type": "boolean"
        },
        "tracks": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "type",
                  "song"
                ],
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "const": "procedural"
                  },
                  "song": {
                    "enum": [
                      "douce-nuit",
                      "mon-beau-sapin",
                      "il-est-ne",
                      "vive-le-vent",
                      "les-anges",
                      "deck-the-halls",
                      "we-wish-you",
                      "greensleeves",
                      "valse-de-givrelune"
                    ]
                  },
                  "title": {
                    "type": "string"
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "type",
                  "src",
                  "title"
                ],
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "const": "file"
                  },
                  "src": {
                    "type": "string",
                    "description": "ex. /music/ma-piste.mp3 (dans public/music)"
                  },
                  "title": {
                    "type": "string"
                  },
                  "author": {
                    "type": "string"
                  },
                  "license": {
                    "type": "string"
                  },
                  "url": {
                    "type": "string"
                  }
                }
              }
            ]
          }
        }
      }
    },
    "cast": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "role"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "enum": [
              "guide",
              "barista",
              "cook",
              "chestnut-seller",
              "glassblower",
              "carousel-keeper",
              "fair-keeper",
              "musician",
              "stargazer",
              "skater",
              "child",
              "villager"
            ]
          },
          "zone": {
            "enum": [
              "gate",
              "plaza",
              "bar",
              "food",
              "workshop",
              "rink",
              "belvedere",
              "fair",
              "carousel"
            ]
          },
          "appearance": {
            "type": "object",
            "additionalProperties": false,
            "description": "Apparence du personnage (tout est optionnel : des valeurs harmonieuses sont tirées au hasard de façon déterministe).",
            "properties": {
              "skin": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$",
                "description": "Couleur hexadécimale, ex. #b8413a"
              },
              "hair": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$",
                "description": "Couleur hexadécimale, ex. #b8413a"
              },
              "hairStyle": {
                "enum": [
                  "short",
                  "long",
                  "bun",
                  "braids",
                  "curly",
                  "ponytail",
                  "bald",
                  "bob"
                ]
              },
              "outfit": {
                "enum": [
                  "coat",
                  "sweater",
                  "apron",
                  "cape",
                  "vest"
                ]
              },
              "outfitColor": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$",
                "description": "Couleur hexadécimale, ex. #b8413a"
              },
              "outfitColor2": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$",
                "description": "Couleur hexadécimale, ex. #b8413a"
              },
              "scarf": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^#[0-9a-fA-F]{6}$",
                    "description": "Couleur hexadécimale, ex. #b8413a"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "null = pas d'écharpe"
              },
              "hat": {
                "enum": [
                  "none",
                  "beanie",
                  "bobble",
                  "beret",
                  "tophat",
                  "chef",
                  "earmuffs",
                  "hood",
                  "cap"
                ]
              },
              "hatColor": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$",
                "description": "Couleur hexadécimale, ex. #b8413a"
              },
              "accessory": {
                "enum": [
                  "none",
                  "glasses",
                  "round-glasses",
                  "apron",
                  "mittens",
                  "bag",
                  "pipe",
                  "flower"
                ]
              },
              "beard": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^#[0-9a-fA-F]{6}$",
                    "description": "Couleur hexadécimale, ex. #b8413a"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "height": {
                "type": "number",
                "minimum": 0.8,
                "maximum": 1.2
              },
              "build": {
                "type": "number",
                "minimum": 0.8,
                "maximum": 1.25
              }
            }
          },
          "voicePitch": {
            "type": "number"
          },
          "lines": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "zones": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gate": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "name": {
              "type": "string"
            },
            "subtitle": {
              "type": "string"
            }
          }
        },
        "plaza": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "name": {
              "type": "string"
            },
            "subtitle": {
              "type": "string"
            }
          }
        },
        "bar": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "name": {
              "type": "string"
            },
            "subtitle": {
              "type": "string"
            }
          }
        },
        "food": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "name": {
              "type": "string"
            },
            "subtitle": {
              "type": "string"
            }
          }
        },
        "workshop": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "name": {
              "type": "string"
            },
            "subtitle": {
              "type": "string"
            }
          }
        },
        "rink": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "name": {
              "type": "string"
            },
            "subtitle": {
              "type": "string"
            }
          }
        },
        "belvedere": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "name": {
              "type": "string"
            },
            "subtitle": {
              "type": "string"
            }
          }
        },
        "fair": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "name": {
              "type": "string"
            },
            "subtitle": {
              "type": "string"
            }
          }
        },
        "carousel": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "name": {
              "type": "string"
            },
            "subtitle": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}